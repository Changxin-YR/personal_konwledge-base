{
  "name": "knowledgeos-panel",
  "version": "0.1.0",
  "private": true,
  "description": "KnowledgeOS foundation slice: real DSH panel, read-only host status, and an SQLite-backed persistence probe",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./storage": {
      "default": "./lib/storage.js"
    },
    "./test-support": {
      "default": "./lib/test-support.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/storage.js",
    "lib/test-support.js",
    "src",
    "build.mjs",
    "tsconfig.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
