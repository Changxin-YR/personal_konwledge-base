{
  "name": "knowledgeos-panel",
  "version": "0.1.0",
  "private": true,
  "description": "KnowledgeOS FND-001: one real DSH panel backed by a read-only Host runtime-status service",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "src",
    "build.mjs",
    "tsconfig.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
